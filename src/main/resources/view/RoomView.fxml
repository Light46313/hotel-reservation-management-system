<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="TOP_CENTER" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="780.0" spacing="15.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="hotel.controller.RoomController">
   <children>
      <Label alignment="TOP_CENTER" text="ROOM MANAGEMENT">
         <font>
            <Font size="28.0" />
         </font>
      </Label>
      <HBox alignment="CENTER" prefHeight="40.0" prefWidth="200.0">
         <children>
            <Label text="Search Room:" />
            <TextField fx:id="searchRoomField" prefWidth="200.0" />
         </children>
      </HBox>
      <HBox prefWidth="780.0">
         <children>
            <VBox spacing="10.0">
               <children>
                  <Label text="Available Facilities">
                     <font>
                        <Font size="14.0" />
                     </font>
                  </Label>
                  <ListView fx:id="facilityListView" prefHeight="200.0" prefWidth="180.0" />
               </children>
            </VBox>
            <TableView fx:id="roomTable" prefHeight="200.0" prefWidth="600.0">
              <columns>
                <TableColumn fx:id="roomNumberColumn" prefWidth="120.0" text="Room Number" />
                <TableColumn fx:id="roomTypeColumn" prefWidth="240.0" text="Room Type" />
                  <TableColumn fx:id="priceColumn" prefWidth="120.0" text="Price" />
                  <TableColumn fx:id="availableColumn" prefWidth="120.0" text="Available" />
              </columns>
            </TableView>
         </children>
      </HBox>
      <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0" spacing="20.0">
         <children>
            <Button fx:id="addRoomButton" mnemonicParsing="false" onAction="#addRoom" prefHeight="40.0" prefWidth="130.0" text="Add Room" />
            <Button fx:id="updateRoomButton" mnemonicParsing="false" onAction="#updateRoom" prefHeight="40.0" prefWidth="130.0" text="Update" />
            <Button fx:id="deleteRoomButton" mnemonicParsing="false" onAction="#deleteRoom" prefHeight="40.0" prefWidth="130.0" text="Delete" />
            <Button mnemonicParsing="false" onAction="#backToMain" prefHeight="40.0" prefWidth="100.0" text="Back" />
         </children>
      </HBox>
   </children>
</VBox>
