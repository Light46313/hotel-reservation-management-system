<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TreeView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane
        xmlns="http://javafx.com/javafx/26"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="hotel.controller.RoomController"
        prefWidth="900.0"
        prefHeight="600.0"
        minWidth="800.0"
        minHeight="500.0">


   <!-- ==================== TOP AREA ==================== -->

   <top>

      <VBox
              alignment="CENTER"
              spacing="12.0">

         <padding>
            <Insets
                    top="15.0"
                    right="20.0"
                    bottom="15.0"
                    left="20.0"/>
         </padding>


         <!-- TITLE -->

         <Label
                 alignment="CENTER"
                 text="ROOM MANAGEMENT">

            <font>
               <Font
                       name="System Bold"
                       size="28.0"/>
            </font>

         </Label>


         <!-- SEARCH -->

         <HBox
                 alignment="CENTER"
                 spacing="10.0">

            <Label
                    text="Search Room">

               <font>
                  <Font size="16.0"/>
               </font>

            </Label>

            <TextField
                    fx:id="searchRoomField"
                    prefWidth="250.0"
                    promptText="Enter room number or room type"/>

         </HBox>

      </VBox>

   </top>


   <!-- ==================== CENTER AREA ==================== -->

   <center>

      <StackPane>

         <HBox
                 spacing="15.0">

            <padding>
               <Insets
                       top="10.0"
                       right="20.0"
                       bottom="10.0"
                       left="20.0"/>
            </padding>


            <!-- ==================== LEFT PANEL ==================== -->

            <VBox
                    spacing="10.0"
                    prefWidth="210.0">

               <Label
                       text="Available Facilities">

                  <font>
                     <Font
                             name="System Bold"
                             size="16.0"/>
                  </font>

               </Label>


               <!-- FACILITIES LIST -->

               <ListView
                       fx:id="facilityListView"
                       prefHeight="200.0"
                       prefWidth="200.0"
                       VBox.vgrow="ALWAYS"/>


               <Label
                       text="Hotel Structure">

                  <font>
                     <Font
                             name="System Bold"
                             size="16.0"/>
                  </font>

               </Label>


               <!-- HOTEL TREE -->

               <TreeView
                       fx:id="hotelTreeView"
                       prefHeight="200.0"
                       prefWidth="200.0"
                       VBox.vgrow="ALWAYS"/>

            </VBox>


            <!-- ==================== ROOM TABLE ==================== -->

            <TableView
                    fx:id="roomTable"
                    prefHeight="400.0"
                    prefWidth="600.0"
                    HBox.hgrow="ALWAYS">

               <columns>

                  <TableColumn
                          fx:id="roomNumberColumn"
                          minWidth="120.0"
                          prefWidth="150.0"
                          text="Room Number"/>

                  <TableColumn
                          fx:id="roomTypeColumn"
                          minWidth="150.0"
                          prefWidth="200.0"
                          text="Room Type"/>

                  <TableColumn
                          fx:id="priceColumn"
                          minWidth="120.0"
                          prefWidth="150.0"
                          text="Price"/>

                  <TableColumn
                          fx:id="availableColumn"
                          minWidth="120.0"
                          prefWidth="150.0"
                          text="Available"/>

               </columns>

            </TableView>

         </HBox>

      </StackPane>

   </center>


   <!-- ==================== BOTTOM AREA ==================== -->

   <bottom>

      <HBox
              alignment="CENTER"
              spacing="20.0"
              prefHeight="70.0">

         <padding>
            <Insets
                    top="10.0"
                    right="20.0"
                    bottom="15.0"
                    left="20.0"/>
         </padding>


         <!-- ADD ROOM -->

         <Button
                 fx:id="addRoomButton"
                 mnemonicParsing="false"
                 onAction="#addRoom"
                 prefHeight="40.0"
                 prefWidth="130.0"
                 text="Add Room"/>


         <!-- UPDATE -->

         <Button
                 fx:id="updateRoomButton"
                 mnemonicParsing="false"
                 onAction="#updateRoom"
                 prefHeight="40.0"
                 prefWidth="130.0"
                 text="Update"/>


         <!-- DELETE -->

         <Button
                 fx:id="deleteRoomButton"
                 mnemonicParsing="false"
                 onAction="#deleteRoom"
                 prefHeight="40.0"
                 prefWidth="130.0"
                 text="Delete"/>


         <!-- BACK -->

         <Button
                 mnemonicParsing="false"
                 onAction="#backToMain"
                 prefHeight="40.0"
                 prefWidth="100.0"
                 text="Back"/>

      </HBox>

   </bottom>

</BorderPane>