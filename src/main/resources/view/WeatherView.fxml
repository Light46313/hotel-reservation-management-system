<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane
        xmlns="http://javafx.com/javafx/26"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="hotel.controller.WeatherController"
        prefWidth="1000.0"
        prefHeight="650.0"
        minWidth="800.0"
        minHeight="550.0"
        style="-fx-background-color: #F5F7FB;">

    <!-- ========================================================= -->
    <!-- TOP HEADER -->
    <!-- ========================================================= -->

    <top>

        <HBox
                alignment="CENTER_LEFT"
                spacing="15.0"
                prefHeight="90.0"
                style="-fx-background-color: #FFFFFF;
                       -fx-border-color: #E2E8F0;
                       -fx-border-width: 0 0 1 0;">

            <padding>

                <Insets
                        top="15.0"
                        right="30.0"
                        bottom="15.0"
                        left="30.0"/>

            </padding>

            <VBox spacing="3.0">

                <Label
                        text="WEATHER INFORMATION"
                        textFill="#1E3A8A">

                    <font>

                        <Font
                                name="System Bold"
                                size="26.0"/>

                    </font>

                </Label>

                <Label
                        text="Get current weather information from the internet"
                        textFill="#64748B">

                    <font>

                        <Font
                                name="System"
                                size="13.0"/>

                    </font>

                </Label>

            </VBox>

            <Region
                    HBox.hgrow="ALWAYS"/>

            <Label
                    text="LIVE DATA"
                    textFill="#16A34A">

                <font>

                    <Font
                            name="System Bold"
                            size="14.0"/>

                </font>

            </Label>

        </HBox>

    </top>


    <!-- ========================================================= -->
    <!-- CENTER -->
    <!-- ========================================================= -->

    <center>

        <VBox
                alignment="TOP_CENTER"
                spacing="20.0"
                style="-fx-background-color: #F5F7FB;">

            <padding>

                <Insets
                        top="30.0"
                        right="40.0"
                        bottom="30.0"
                        left="40.0"/>

            </padding>


            <!-- ================================================= -->
            <!-- SEARCH CARD -->
            <!-- ================================================= -->

            <VBox
                    spacing="12.0"
                    maxWidth="750.0"
                    style="-fx-background-color: #DBEAFE;
                           -fx-background-radius: 12;
                           -fx-border-color: #93C5FD;
                           -fx-border-radius: 12;
                           -fx-border-width: 1;
                           -fx-padding: 20;">

                <Label
                        text="Search Weather"
                        textFill="#1E3A8A">

                    <font>

                        <Font
                                name="System Bold"
                                size="19.0"/>

                    </font>

                </Label>

                <Label
                        text="Enter a city name to retrieve its current weather information."
                        textFill="#475569">

                    <font>

                        <Font
                                name="System"
                                size="13.0"/>

                    </font>

                </Label>

                <HBox
                        alignment="CENTER_LEFT"
                        spacing="12.0">

                    <TextField
                            fx:id="cityField"
                            prefHeight="42.0"
                            prefWidth="450.0"
                            promptText="Enter city name"
                            HBox.hgrow="ALWAYS"
                            style="-fx-background-color: #FFFFFF;
                                   -fx-border-color: #CBD5E1;
                                   -fx-border-width: 1;
                                   -fx-background-radius: 8;
                                   -fx-border-radius: 8;
                                   -fx-padding: 8 12 8 12;
                                   -fx-font-size: 13px;"/>

                    <Button
                            fx:id="refreshWeatherButton"
                            mnemonicParsing="false"
                            onAction="#refreshWeather"
                            prefHeight="42.0"
                            prefWidth="180.0"
                            text="Refresh Weather"
                            style="-fx-background-color: #2563EB;
                                   -fx-text-fill: white;
                                   -fx-font-size: 13px;
                                   -fx-font-weight: bold;
                                   -fx-background-radius: 8;
                                   -fx-cursor: hand;"/>

                </HBox>

            </VBox>


            <!-- ================================================= -->
            <!-- WEATHER RESULT CARD -->
            <!-- ================================================= -->

            <VBox
                    spacing="18.0"
                    maxWidth="750.0"
                    style="-fx-background-color: #FFFFFF;
                           -fx-background-radius: 12;
                           -fx-border-color: #E2E8F0;
                           -fx-border-radius: 12;
                           -fx-border-width: 1;
                           -fx-padding: 25;">

                <HBox
                        alignment="CENTER_LEFT">

                    <VBox spacing="4.0">

                        <Label
                                text="Current Weather"
                                textFill="#172554">

                            <font>

                                <Font
                                        name="System Bold"
                                        size="22.0"/>

                            </font>

                        </Label>

                        <Label
                                text="Live information received from an online API"
                                textFill="#64748B">

                            <font>

                                <Font
                                        name="System"
                                        size="13.0"/>

                            </font>

                        </Label>

                    </VBox>

                    <Region
                            HBox.hgrow="ALWAYS"/>

                    <Label
                            text="ONLINE API"
                            textFill="#2563EB">

                        <font>

                            <Font
                                    name="System Bold"
                                    size="12.0"/>

                        </font>

                    </Label>

                </HBox>


                <!-- CITY -->

                <VBox
                        alignment="CENTER"
                        spacing="5.0"
                        style="-fx-background-color: #EFF6FF;
                               -fx-background-radius: 10;
                               -fx-padding: 18;">

                    <Label
                            text="CITY"
                            textFill="#64748B">

                        <font>

                            <Font
                                    name="System Bold"
                                    size="11.0"/>

                        </font>

                    </Label>

                    <Label
                            fx:id="cityLabel"
                            text="--"
                            textFill="#1E3A8A">

                        <font>

                            <Font
                                    name="System Bold"
                                    size="25.0"/>

                        </font>

                    </Label>

                </VBox>


                <!-- WEATHER VALUES -->

                <HBox
                        spacing="15.0"
                        alignment="CENTER">

                    <!-- TEMPERATURE -->

                    <VBox
                            alignment="CENTER"
                            spacing="7.0"
                            prefWidth="210.0"
                            HBox.hgrow="ALWAYS"
                            style="-fx-background-color: #FEF3C7;
                                   -fx-background-radius: 10;
                                   -fx-padding: 20;">

                        <Label
                                text="TEMPERATURE"
                                textFill="#92400E">

                            <font>

                                <Font
                                        name="System Bold"
                                        size="11.0"/>

                            </font>

                        </Label>

                        <Label
                                fx:id="temperatureLabel"
                                text="-- °C"
                                textFill="#B45309">

                            <font>

                                <Font
                                        name="System Bold"
                                        size="24.0"/>

                            </font>

                        </Label>

                    </VBox>


                    <!-- HUMIDITY -->

                    <VBox
                            alignment="CENTER"
                            spacing="7.0"
                            prefWidth="210.0"
                            HBox.hgrow="ALWAYS"
                            style="-fx-background-color: #DBEAFE;
                                   -fx-background-radius: 10;
                                   -fx-padding: 20;">

                        <Label
                                text="HUMIDITY"
                                textFill="#1E40AF">

                            <font>

                                <Font
                                        name="System Bold"
                                        size="11.0"/>

                            </font>

                        </Label>

                        <Label
                                fx:id="humidityLabel"
                                text="--%"
                                textFill="#2563EB">

                            <font>

                                <Font
                                        name="System Bold"
                                        size="24.0"/>

                            </font>

                        </Label>

                    </VBox>


                    <!-- CONDITION -->

                    <VBox
                            alignment="CENTER"
                            spacing="7.0"
                            prefWidth="210.0"
                            HBox.hgrow="ALWAYS"
                            style="-fx-background-color: #DCFCE7;
                                   -fx-background-radius: 10;
                                   -fx-padding: 20;">

                        <Label
                                text="CONDITION"
                                textFill="#166534">

                            <font>

                                <Font
                                        name="System Bold"
                                        size="11.0"/>

                            </font>

                        </Label>

                        <Label
                                fx:id="conditionLabel"
                                text="--"
                                textFill="#15803D"
                                wrapText="true"
                                alignment="CENTER">

                            <font>

                                <Font
                                        name="System Bold"
                                        size="18.0"/>

                            </font>

                        </Label>

                    </VBox>

                </HBox>


                <!-- STATUS -->

                <HBox
                        alignment="CENTER"
                        style="-fx-background-color: #F8FAFC;
                               -fx-background-radius: 8;
                               -fx-padding: 12;">

                    <Label
                            fx:id="statusLabel"
                            text="Enter a city and click Refresh Weather."
                            textFill="#64748B">

                        <font>

                            <Font
                                    name="System"
                                    size="12.0"/>

                        </font>

                    </Label>

                </HBox>

            </VBox>

        </VBox>

    </center>


    <!-- ========================================================= -->
    <!-- BOTTOM -->
    <!-- ========================================================= -->

    <bottom>

        <HBox
                alignment="CENTER_RIGHT"
                spacing="12.0"
                prefHeight="70.0"
                style="-fx-background-color: #FFFFFF;
                       -fx-border-color: #E2E8F0;
                       -fx-border-width: 1 0 0 0;">

            <padding>

                <Insets
                        top="12.0"
                        right="30.0"
                        bottom="12.0"
                        left="30.0"/>

            </padding>

            <Region
                    HBox.hgrow="ALWAYS"/>

            <!-- BACK BUTTON -->

            <Button
                    mnemonicParsing="false"
                    onAction="#backToMain"
                    prefHeight="42.0"
                    prefWidth="100.0"
                    text="Back"
                    style="-fx-background-color: #E2E8F0;
                           -fx-text-fill: #334155;
                           -fx-font-size: 13px;
                           -fx-font-weight: bold;
                           -fx-background-radius: 8;
                           -fx-cursor: hand;"/>

        </HBox>

    </bottom>

</BorderPane>