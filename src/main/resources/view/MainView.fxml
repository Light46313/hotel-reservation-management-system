<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="20" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="hotel.controller.MainController">

    <padding>
        <Insets bottom="40" left="40" right="40" top="40" />
    </padding>

    <Label style="-fx-font-size: 24px; -fx-font-weight: bold;" text="HOTEL RESERVATION AND MANAGEMENT SYSTEM" />

    <Button onAction="#openRoomManagement" prefHeight="40" prefWidth="250" text="Room Management" />

    <Button onAction="#openCustomerManagement" prefHeight="40" prefWidth="250" text="Customer Management" />

    <Button onAction="#openBooking" prefHeight="40" prefWidth="250" text="Booking" />

    <Button onAction="#openBookingHistory" prefHeight="40" prefWidth="250" text="Booking History" />

    <Button onAction="#exitApplication" prefHeight="40" prefWidth="250" text="Exit" />
   <Button mnemonicParsing="false" onAction="#handleTestEvent" text="Test Event Handling" />
   <Label fx:id="eventStatusLabel" text="Event Status">
      <font>
         <Font size="18.0" />
      </font>
   </Label>

</VBox>
