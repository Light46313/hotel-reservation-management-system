<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<StackPane
        xmlns="http://javafx.com/javafx/26"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="hotel.controller.LoginController"
        prefWidth="600.0"
        prefHeight="450.0"
        minWidth="500.0"
        minHeight="400.0">

   <!-- ==================== LOGIN FORM ==================== -->

   <VBox
           alignment="CENTER"
           spacing="15.0"
           maxWidth="500.0">

      <padding>

         <Insets
                 top="30.0"
                 right="30.0"
                 bottom="30.0"
                 left="30.0"/>

      </padding>


      <!-- ==================== TITLE ==================== -->

      <Label
              alignment="CENTER"
              text="HOTEL MANAGEMENT LOGIN">

         <font>
            <Font
                    name="System Bold"
                    size="26.0"/>
         </font>

      </Label>


      <!-- ==================== USERNAME ==================== -->

      <HBox
              alignment="CENTER"
              spacing="10.0"
              maxWidth="400.0">

         <Label
                 alignment="CENTER_RIGHT"
                 prefWidth="110.0"
                 text="Username:">

            <font>
               <Font size="18.0"/>
            </font>

         </Label>


         <TextField
                 fx:id="usernameField"
                 prefHeight="35.0"
                 prefWidth="240.0"
                 promptText="Enter username"/>

      </HBox>


      <!-- ==================== PASSWORD ==================== -->

      <HBox
              alignment="CENTER"
              spacing="10.0"
              maxWidth="400.0">

         <Label
                 alignment="CENTER_RIGHT"
                 prefWidth="110.0"
                 text="Password:">

            <font>
               <Font size="18.0"/>
            </font>

         </Label>


         <PasswordField
                 fx:id="passwordField"
                 prefHeight="35.0"
                 prefWidth="240.0"
                 promptText="Enter password"/>

      </HBox>


      <!-- ==================== SHOW PASSWORD ==================== -->

      <CheckBox
              fx:id="showPasswordCheckBox"
              mnemonicParsing="false"
              onAction="#togglePasswordVisibility"
              text="Show Password">

         <font>
            <Font size="14.0"/>
         </font>

      </CheckBox>


      <!-- ==================== LOGIN BUTTON ==================== -->

      <Button
              fx:id="loginButton"
              mnemonicParsing="false"
              onAction="#login"
              prefHeight="40.0"
              prefWidth="140.0"
              text="Login">

         <font>
            <Font size="15.0"/>
         </font>

      </Button>


      <!-- ==================== CHANGE CREDENTIALS ==================== -->

      <Button
              fx:id="changePasswordButton"
              mnemonicParsing="false"
              onAction="#changeCredentials"
              prefHeight="40.0"
              prefWidth="240.0"
              text="Change Username / Password">

         <font>
            <Font size="14.0"/>
         </font>

      </Button>

   </VBox>

</StackPane>