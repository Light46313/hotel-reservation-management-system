<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane
        xmlns="http://javafx.com/javafx/26"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="hotel.controller.MainController"
        prefWidth="1000.0"
        prefHeight="600.0"
        minWidth="900.0"
        minHeight="550.0">

    <!-- ==================== TOP ==================== -->

    <top>

        <VBox
                alignment="CENTER"
                spacing="8.0">

            <MenuBar>

                <menus>

                    <Menu
                            mnemonicParsing="false"
                            text="File">

                        <items>

                            <MenuItem
                                    mnemonicParsing="false"
                                    onAction="#newAction"
                                    text="New"/>

                            <MenuItem
                                    mnemonicParsing="false"
                                    onAction="#openAction"
                                    text="Open"/>

                            <MenuItem
                                    mnemonicParsing="false"
                                    onAction="#exitApplication"
                                    text="Exit"/>

                        </items>

                    </Menu>

                </menus>

            </MenuBar>


            <!-- TITLE -->

            <Label
                    alignment="CENTER"
                    text="HOTEL RESERVATION AND MANAGEMENT SYSTEM">

                <font>
                    <Font
                            name="System Bold"
                            size="26.0"/>
                </font>

            </Label>

        </VBox>

    </top>


    <!-- ==================== LEFT ==================== -->

    <left>

        <VBox
                alignment="TOP_CENTER"
                spacing="15.0"
                prefWidth="210.0">

            <padding>

                <Insets
                        top="25.0"
                        right="20.0"
                        bottom="25.0"
                        left="20.0"/>

            </padding>


            <Button
                    maxWidth="Infinity"
                    prefHeight="45.0"
                    onAction="#openRoomManagement"
                    text="Room Management"/>


            <Button
                    maxWidth="Infinity"
                    prefHeight="45.0"
                    onAction="#openCustomerManagement"
                    text="Customer Management"/>


            <Button
                    maxWidth="Infinity"
                    prefHeight="45.0"
                    onAction="#openBooking"
                    text="Booking"/>


            <Button
                    maxWidth="Infinity"
                    prefHeight="45.0"
                    onAction="#openBookingHistory"
                    text="Booking History"/>


            <Button
                    maxWidth="Infinity"
                    prefHeight="45.0"
                    onAction="#exitApplication"
                    text="Exit"/>

        </VBox>

    </left>


    <!-- ==================== CENTER ==================== -->

    <center>

        <StackPane>

            <VBox
                    alignment="CENTER"
                    spacing="25.0"
                    maxWidth="650.0">

                <!-- WELCOME -->

                <Label
                        alignment="CENTER"
                        text="Welcome to Hotel Reservation and Management System"
                        wrapText="true">

                    <font>
                        <Font
                                name="System"
                                size="26.0"/>
                    </font>

                </Label>


                <!-- INSTRUCTION -->

                <Label
                        alignment="CENTER"
                        text="Select an option from the left panel to continue."
                        wrapText="true">

                    <font>
                        <Font size="18.0"/>
                    </font>

                </Label>


                <!-- DASHBOARD INFORMATION -->

                <VBox
                        alignment="CENTER"
                        spacing="10.0">

                    <Label
                            text="Hotel Management Dashboard">

                        <font>
                            <Font
                                    name="System Bold"
                                    size="20.0"/>
                        </font>

                    </Label>


                    <Label
                            alignment="CENTER"
                            text="Manage rooms, customers, bookings and booking history from one place."
                            wrapText="true"
                            maxWidth="550.0">

                        <font>
                            <Font size="16.0"/>
                        </font>

                    </Label>

                </VBox>

            </VBox>

        </StackPane>

    </center>


    <!-- ==================== BOTTOM ==================== -->

    <bottom>

        <HBox
                alignment="CENTER"
                spacing="30.0"
                prefHeight="70.0">

            <padding>

                <Insets
                        top="10.0"
                        right="10.0"
                        bottom="15.0"
                        left="10.0"/>

            </padding>


            <!-- RESPONSIVE REFRESH BUTTON -->

            <Button
                    fx:id="refreshDataButton"
                    onAction="#refreshData"
                    prefHeight="40.0"
                    prefWidth="150.0"
                    text="Refresh Data"/>


            <!-- RESPONSIVE LOGOUT BUTTON -->

            <Button
                    fx:id="logoutButton"
                    onAction="#logout"
                    prefHeight="40.0"
                    prefWidth="120.0"
                    text="Logout"/>

        </HBox>

    </bottom>

</BorderPane>