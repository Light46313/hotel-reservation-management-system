<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="TOP_CENTER" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="600.0" prefWidth="800.0" spacing="15.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="hotel.controller.CustomerController">
   <children>
      <Label text="CUSTOMER MANAGEMENT">
         <font>
            <Font size="28.0" />
         </font>
      </Label>
      <TableView fx:id="customerTable" prefHeight="200.0" prefWidth="200.0">
        <columns>
          <TableColumn fx:id="customerIdColumn" minWidth="100.0" prefWidth="75.0" text="Customer ID" />
          <TableColumn fx:id="nameColumn" minWidth="175.0" prefWidth="75.0" text="Name" />
            <TableColumn fx:id="phoneColumn" minWidth="175.0" prefWidth="75.0" text="Phone" />
            <TableColumn fx:id="emailColumn" minWidth="175.0" prefWidth="75.0" text="Email" />
            <TableColumn fx:id="addressColumn" minWidth="175.0" prefWidth="75.0" text="Address" />
        </columns>
      </TableView>
      <Label text="Customer Photo" />
      <ImageView fx:id="customerImageView" fitHeight="120.0" fitWidth="120.0" pickOnBounds="true" preserveRatio="true" />
      <Button mnemonicParsing="false" onAction="#browseImage" text="Browse Image" />
      <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0" spacing="20.0">
         <children>
            <Button mnemonicParsing="false" onAction="#addCustomer" prefHeight="50.0" prefWidth="100.0" text="Add Customer" />
            <Button mnemonicParsing="false" onAction="#updateCustomer" prefHeight="50.0" prefWidth="100.0" text="Update" />
            <Button mnemonicParsing="false" onAction="#deleteCustomer" prefHeight="50.0" prefWidth="100.0" text="Delete" />
            <Button mnemonicParsing="false" onAction="#backToMain" prefHeight="50.0" prefWidth="100.0" text="Back" />
            <Button fx:id="bookSelectedCustomerButton" mnemonicParsing="false" onAction="#bookSelectedCustomer" prefHeight="50.0" prefWidth="150.0" text="Book Selected Customer" />
         </children>
      </HBox>
   </children>
</VBox>
