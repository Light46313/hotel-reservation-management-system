<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane
        xmlns="http://javafx.com/javafx/26"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="hotel.controller.CustomerController"
        prefWidth="900.0"
        prefHeight="650.0"
        minWidth="800.0"
        minHeight="550.0">


   <!-- ==================== TOP AREA ==================== -->

   <top>

      <VBox alignment="CENTER">

         <padding>
            <Insets
                    top="15.0"
                    right="20.0"
                    bottom="15.0"
                    left="20.0"/>
         </padding>

         <Label
                 alignment="CENTER"
                 text="CUSTOMER MANAGEMENT">

            <font>
               <Font
                       name="System Bold"
                       size="28.0"/>
            </font>

         </Label>

      </VBox>

   </top>


   <!-- ==================== CENTER AREA ==================== -->

   <center>

      <StackPane>

         <VBox
                 spacing="15.0">

            <padding>
               <Insets
                       top="10.0"
                       right="20.0"
                       bottom="10.0"
                       left="20.0"/>
            </padding>


            <!-- ==================== CUSTOMER TABLE ==================== -->

            <TableView
                    fx:id="customerTable"
                    prefHeight="300.0"
                    VBox.vgrow="ALWAYS">

               <columns>

                  <TableColumn
                          fx:id="customerIdColumn"
                          minWidth="100.0"
                          prefWidth="120.0"
                          text="Customer ID"/>

                  <TableColumn
                          fx:id="nameColumn"
                          minWidth="150.0"
                          prefWidth="180.0"
                          text="Name"/>

                  <TableColumn
                          fx:id="phoneColumn"
                          minWidth="150.0"
                          prefWidth="180.0"
                          text="Phone"/>

                  <TableColumn
                          fx:id="emailColumn"
                          minWidth="180.0"
                          prefWidth="220.0"
                          text="Email"/>

                  <TableColumn
                          fx:id="addressColumn"
                          minWidth="180.0"
                          prefWidth="220.0"
                          text="Address"/>

               </columns>

            </TableView>


            <!-- ==================== CUSTOMER DETAILS ==================== -->

            <HBox
                    alignment="CENTER"
                    spacing="30.0"
                    prefHeight="180.0">


               <!-- CUSTOMER PHOTO -->

               <VBox
                       alignment="CENTER"
                       spacing="10.0"
                       prefWidth="180.0">

                  <Label
                          text="Customer Photo">

                     <font>
                        <Font
                                name="System Bold"
                                size="15.0"/>
                     </font>

                  </Label>


                  <ImageView
                          fx:id="customerImageView"
                          fitHeight="120.0"
                          fitWidth="120.0"
                          pickOnBounds="true"
                          preserveRatio="true"/>


                  <Button
                          mnemonicParsing="false"
                          onAction="#browseImage"
                          prefWidth="130.0"
                          text="Browse Image"/>

               </VBox>


               <!-- SPECIAL REQUEST -->

               <VBox
                       alignment="TOP_CENTER"
                       spacing="10.0"
                       prefWidth="400.0"
                       HBox.hgrow="ALWAYS">

                  <Label
                          text="Special Request:">

                     <font>
                        <Font
                                size="15.0"/>
                     </font>

                  </Label>


                  <TextArea
                          fx:id="specialRequestTextArea"
                          prefHeight="120.0"
                          prefWidth="400.0"
                          promptText="Enter special request..."
                          VBox.vgrow="ALWAYS"/>


                  <Button
                          fx:id="clearSpecialRequestButton"
                          mnemonicParsing="false"
                          onAction="#clearSpecialRequest"
                          prefWidth="100.0"
                          text="Clear"/>

               </VBox>

            </HBox>

         </VBox>

      </StackPane>

   </center>


   <!-- ==================== BOTTOM AREA ==================== -->

   <bottom>

      <HBox
              alignment="CENTER"
              spacing="15.0"
              prefHeight="75.0">

         <padding>
            <Insets
                    top="10.0"
                    right="20.0"
                    bottom="15.0"
                    left="20.0"/>
         </padding>


         <!-- ADD CUSTOMER -->

         <Button
                 mnemonicParsing="false"
                 onAction="#addCustomer"
                 prefHeight="40.0"
                 prefWidth="120.0"
                 text="Add Customer"/>


         <!-- UPDATE -->

         <Button
                 mnemonicParsing="false"
                 onAction="#updateCustomer"
                 prefHeight="40.0"
                 prefWidth="110.0"
                 text="Update"/>


         <!-- DELETE -->

         <Button
                 mnemonicParsing="false"
                 onAction="#deleteCustomer"
                 prefHeight="40.0"
                 prefWidth="110.0"
                 text="Delete"/>


         <!-- BACK -->

         <Button
                 mnemonicParsing="false"
                 onAction="#backToMain"
                 prefHeight="40.0"
                 prefWidth="100.0"
                 text="Back"/>


         <!-- BOOK SELECTED CUSTOMER -->

         <Button
                 fx:id="bookSelectedCustomerButton"
                 mnemonicParsing="false"
                 onAction="#bookSelectedCustomer"
                 prefHeight="40.0"
                 prefWidth="180.0"
                 text="Book Selected Customer"/>

      </HBox>

   </bottom>

</BorderPane>